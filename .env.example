# Copy to .env and fill in. Never commit .env.

# Paths
ROLEEYE_DATA_DIR=./data
ROLEEYE_ARTIFACTS_DIR=./artifacts
ROLEEYE_DB_PATH=./data/roleeye.db

# Logging: error | warn | info | debug
ROLEEYE_LOG_LEVEL=info

# Reasoning provider: copilot | openai | none
ROLEEYE_REASONING_PROVIDER=copilot
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Embedding provider: none | local | openai
ROLEEYE_EMBEDDING_PROVIDER=none

# VPS sync (see config/sync.example.yaml)
# ROLEEYE_SYNC_HOST=
# ROLEEYE_SYNC_USER=
# ROLEEYE_SYNC_SSH_KEY=
